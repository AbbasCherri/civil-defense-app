<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.CivilDefence" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_navy</item>
        <item name="colorPrimaryVariant">@color/primary_navy_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/primary_red</item>
        <item name="colorSecondaryVariant">@color/primary_red_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:windowBackground">@color/surface_light</item>
        <item name="android:statusBarColor">@color/primary_navy</item>
    </style>

    <style name="Theme.CivilDefence" parent="Base.Theme.CivilDefence" />

    <!-- Style for Material Buttons -->
    <style name="Widget.CivilDefence.Button" parent="Widget.Material3.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.CivilDefence.SmallComponent</item>
    </style>

    <!-- Style for Emergency Buttons -->
    <style name="Widget.CivilDefence.Button.Emergency" parent="Widget.CivilDefence.Button">
        <item name="backgroundTint">@color/primary_red</item>
    </style>

    <style name="ShapeAppearance.CivilDefence.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">8dp</item>
    </style>

    <!-- Base application theme compatibility. -->
    <style name="Theme.AppCompat.Light.DarkActionBar" parent="Base.Theme.CivilDefence" />
</resources>