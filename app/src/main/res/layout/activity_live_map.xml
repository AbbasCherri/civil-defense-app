<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Map placeholder -->
    <View
        android:id="@+id/map_placeholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E0E0E0" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🗺️ Map View\n(Google Maps / Mapbox)\n\n📍 Active Incidents: 3\n🚒 Vehicles Online: 5"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_centerInParent="true"
        android:background="#AAFFFFFF"
        android:padding="16dp" />

    <!-- Control Panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#FFFFFF">

        <Button
            android:id="@+id/btn_refresh"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔄 Refresh"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_toggle_risk_zones"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚠️ Risk Zones"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_toggle_vehicles"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🚒 Vehicles" />

    </LinearLayout>

</RelativeLayout>